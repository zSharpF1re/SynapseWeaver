// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
model Graph {
  id        String   @id @default(uuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nodes     Node[]
}

model Node {
  id          String    @id @default(uuid())
  graphId     String
  graph       Graph     @relation(fields: [graphId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  createdAt   DateTime  @default(now())
  embedding   Unsupported("vector(768)")?

  contents    Content[]
  edgesFrom   Edge[]    @relation("source")
  edgesTo     Edge[]    @relation("target")

  @@index([graphId])
}

model Content {
  id            String      @id @default(uuid())
  nodeId        String
  node          Node        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  type          ContentType
  text          String?
  fileUrl       String?
  createdAt     DateTime    @default(now())

  generatedNodes Edge[]     @relation("generatedFrom")
}

enum ContentType {
  TEXT
  DOCUMENT
  AI_GENERATED
}

model Edge {
  id                      String    @id @default(uuid())
  sourceNodeId            String
  targetNodeId            String
  source                  Node      @relation("source", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target                  Node      @relation("target", fields: [targetNodeId], references: [id], onDelete: Cascade)
  generatedFromContentId  String?
  generatedFromContent    Content?  @relation("generatedFrom", fields: [generatedFromContentId], references: [id], onDelete: SetNull)
  createdAt               DateTime  @default(now())
  weight                  Float
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}
